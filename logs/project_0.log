"""Document loading, chunking and BM25 ranking."""

import math
import re
from collections import Counter
from collections.abc import Iterable
from dataclasses import dataclass
from pathlib import Path

MAX_CHUNK_LENGTH = 800
MAX_RESULTS = 3
K1 = 1.5
B = 0.75
SUFFIXES = (".md", ".txt")
STOPWORDS = frozenset(
    "a an and are as at be by can do does for from how i in is it of on or that "
    "the this to was what when where which who why with you".split()
)
# Word characters without the underscore: Unicode letters and digits.
TOKEN = re.compile(r"[^\W_]+")


class DocumentError(Exception):
    """The documents folder or one of its files cannot be read."""


@dataclass(frozen=True)
class Chunk:
    file: str
    position: int
    text: str


@dataclass(frozen=True)
class Result:
    chunk: Chunk
    score: float


def load_chunks(folder: Path) -> list[Chunk]:
    """Chunk every .md and .txt file directly inside the folder."""
    if not folder.is_dir():
        raise DocumentError(f"Documents folder not found: {folder}")
    paths = sorted(
        (p for p in folder.iterdir() if p.name.endswith(SUFFIXES) and p.is_file()),
        key=lambda p: p.name,
    )
    chunks = []
    for path in paths:
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError as error:
            raise DocumentError(f"Document {path} is not valid UTF-8") from error
        chunks.extend(
            Chunk(file=path.name, position=position, text=piece)
            for position, piece in enumerate(chunk_text(text))
        )
    return chunks


def chunk_text(text: str) -> list[str]:
    """Split text on blank lines, attach headings and limit the chunk length."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    chunks = []
    headings: list[str] = []
    for block in re.split(r"\n\s*\n", text):
        block = block.strip()
        if not block:
            continue
        if all(line.lstrip().startswith("#") for line in block.split("\n")):
            headings.append(block)
            continue
        chunks.extend(_split("\n".join([*headings, block])))
        headings = []
    # Headings still pending here have no following block and are dropped.
    return chunks


def _split(text: str) -> list[str]:
    pieces = []
    while len(text) > MAX_CHUNK_LENGTH:
        cut = next(
            (i for i in range(MAX_CHUNK_LENGTH, 0, -1) if text[i].isspace()), None
        )
        if cut is None:
            pieces.append(text[:MAX_CHUNK_LENGTH])
            text = text[MAX_CHUNK_LENGTH:]
        else:
            pieces.append(text[:cut].rstrip())
            text = text[cut:].lstrip()
    pieces.append(text)
    return pieces


def tokenize(text: str) -> list[str]:
    return [token for token in TOKEN.findall(text.lower()) if token not in STOPWORDS]


class Index:
    """An in-memory BM25 index over chunks."""

    def __init__(self, chunks: Iterable[Chunk]):
        self.chunks = list(chunks)
        self._counts = [Counter(tokenize(chunk.text)) for chunk in self.chunks]
        self._lengths = [counts.total() for counts in self._counts]
        self._average_length = sum(self._lengths) / max(len(self.chunks), 1)
        self._frequencies = Counter(token for counts in self._counts for token in counts)

    def search(self, question: str) -> list[Result]:
        """Return the best matching chunks, highest score first."""
        tokens = list(dict.fromkeys(tokenize(question)))
        results = []
        for chunk, counts, length in zip(self.chunks, self._counts, self._lengths):
            score = sum(
                self._term_score(token, counts[token], length)
                for token in tokens
                if token in counts
            )
            if score > 0:
                results.append(Result(chunk, score))
        results.sort(key=lambda r: (-r.score, r.chunk.file, r.chunk.position))
        return results[:MAX_RESULTS]

    def _term_score(self, token: str, count: int, length: int) -> float:
        total = len(self.chunks)
        containing = self._frequencies[token]
        idf = math.log(1 + (total - containing + 0.5) / (containing + 0.5))
        norm = 1 - B + B * length / self._average_length
        return idf * count * (K1 + 1) / (count + K1 * norm)
EOF

cat > app/llm.py <<'EOF'
"""The built-in stub and the OpenAI-compatible proxy."""

from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass
from typing import Literal

import httpx

from app.retrieval import Chunk

TIMEOUT_SECONDS = 30.0
SYSTEM_PROMPT = (
    "Answer the question using only the supplied context. "
    "If the context is not enough to answer, say so."
)

Mode = Literal["stub", "proxy"]


class ConfigError(Exception):
    """The environment settings are incomplete."""


class LLMError(Exception):
    """The LLM request failed. The message never holds secrets or reply bodies."""


@dataclass(frozen=True)
class LLM:
    mode: Mode
    # Takes the question and the retrieved chunks (best first, at least one).
    answer: Callable[[str, Sequence[Chunk]], str]


def create_llm(
    env: Mapping[str, str], transport: httpx.BaseTransport | None = None
) -> LLM:
    """Choose stub or proxy mode from the environment."""
    base = env.get("LLM_PROXY_URL", "")
    if not base:
        return LLM("stub", _stub_answer)
    model = env.get("LLM_PROXY_MODEL", "")
    if not model:
        raise ConfigError("LLM_PROXY_MODEL is required when LLM_PROXY_URL is set")
    url = f"{base.removesuffix('/')}/chat/completions"
    key = env.get("LLM_PROXY_API_KEY", "")
    headers = {"Authorization": f"Bearer {key}"} if key else {}

    def answer(question: str, chunks: Sequence[Chunk]) -> str:
        body = {"model": model, "messages": _messages(question, chunks)}
        return _request_completion(url, headers, body, transport)

    return LLM("proxy", answer)


def _stub_answer(question: str, chunks: Sequence[Chunk]) -> str:
    top = chunks[0]
    return f"[stub] Based on {top.file}: {top.text}"


def _messages(question: str, chunks: Sequence[Chunk]) -> list[dict[str, str]]:
    context = "\n\n".join(f"[{chunk.file}]\n{chunk.text}" for chunk in chunks)
    return [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": f"Context:\n\n{context}\n\nQuestion: {question}"},
    ]


def _request_completion(
    url: str,
    headers: dict[str, str],
    body: dict,
    transport: httpx.BaseTransport | None,
) -> str:
    # Errors are raised "from None" so that no traceback can show the key or body.
    try:
        with httpx.Client(timeout=TIMEOUT_SECONDS, transport=transport) as client:
            response = client.post(url, headers=headers, json=body)
        if not response.is_success:
            raise LLMError(f"LLM returned status {response.status_code}")
        content = response.json()["choices"][0]["message"]["content"]
    except (httpx.HTTPError, httpx.InvalidURL) as error:
        raise LLMError(f"LLM request failed: {type(error).__name__}") from None
    except (ValueError, KeyError, IndexError, TypeError, RecursionError):
        raise LLMError("LLM request or reply was invalid") from None
    if not isinstance(content, str) or not content:
        raise LLMError("LLM reply had no content")
    return content
EOF

cat > app/main.py <<'EOF'
"""App factory, settings and endpoints.

Run with: uvicorn app.main:create_app --factory
"""

import os
from collections.abc import Mapping
from pathlib import Path
from typing import Annotated

import httpx
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, StringConstraints

from app.llm import LLMError, Mode, create_llm
from app.retrieval import Index, load_chunks

DEFAULT_DOCS_DIR = Path(__file__).resolve().parents[2] / "data"
NO_MATCH_ANSWER = "I couldn't find anything relevant in the documents."


class AskRequest(BaseModel):
    question: Annotated[
        str, StringConstraints(strip_whitespace=True, min_length=1, max_length=1000)
    ]


class Source(BaseModel):
    file: str
    text: str
    score: float


class AskResponse(BaseModel):
    answer: str
    sources: list[Source]
    mode: Mode


def docs_dir(env: Mapping[str, str]) -> Path:
    """The DOCS_DIR setting; data/ at the project root when unset or empty."""
    configured = env.get("DOCS_DIR", "")
    return Path(configured) if configured else DEFAULT_DOCS_DIR


def create_app(transport: httpx.BaseTransport | None = None) -> FastAPI:
    """Build the app from the environment. Documents are read and indexed here.

    The transport replaces the network for LLM requests in tests.
    """
    llm = create_llm(os.environ, transport=transport)
    index = Index(load_chunks(docs_dir(os.environ)))
    app = FastAPI(title="Minimal RAG")

    @app.get("/health")
    def health() -> dict[str, str | int]:
        return {"status": "ok", "chunks": len(index.chunks)}

    # A plain function, so the blocking LLM request runs in the thread pool.
    @app.post("/ask")
    def ask(request: AskRequest) -> AskResponse:
        results = index.search(request.question)
        if not results:
            return AskResponse(answer=NO_MATCH_ANSWER, sources=[], mode=llm.mode)
        try:
            answer = llm.answer(request.question, [r.chunk for r in results])
        except LLMError:
            raise HTTPException(status_code=502, detail="LLM request failed") from None
        sources = [
            Source(file=r.chunk.file, text=r.chunk.text, score=r.score) for r in results
        ]
        return AskResponse(answer=answer, sources=sources, mode=llm.mode)

    return app
EOF
