import os, signal, socket, subprocess, tempfile, time
import httpx

def port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0)); return s.getsockname()[1]

def start(cmd, env):
    log = tempfile.TemporaryFile()
    return subprocess.Popen(cmd, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)

def stop(p):
    try: os.killpg(p.pid, signal.SIGTERM)
    except ProcessLookupError: pass
    p.wait(15)

bp, fp = port(), port()
env = {k: v for k, v in os.environ.items() if not k.startswith("LLM_") and k != "DOCS_DIR"}
procs = []
try:
    be = start(["backend/.venv/bin/python", "-m", "uvicorn", "app.main:create_app", "--factory", "--app-dir", "backend", "--port", str(bp)], env); procs.append(be)
    fe = start(["npm", "--prefix", "frontend", "run", "dev", "--", "-H", "127.0.0.1", "-p", str(fp)], {**env, "BACKEND_URL": f"http://127.0.0.1:{bp}", "NEXT_TELEMETRY_DISABLED": "1"}); procs.append(fe)
    c = httpx.Client(trust_env=False, timeout=40)
    def wait(url):
        for _ in range(200):
            try:
                if c.get(url).status_code == 200: return
            except httpx.HTTPError: pass
            time.sleep(0.3)
        raise SystemExit("not ready " + url)
    wait(f"http://127.0.0.1:{bp}/health"); wait(f"http://127.0.0.1:{fp}/")
    def ask(q):
        r = c.post(f"http://127.0.0.1:{fp}/api/ask", json={"question": q}); print(r.status_code, r.text[:160])
    ask("How do I clean a bicycle chain?")
    stop(be); ask("coffee")
finally:
    for p in procs: stop(p)
EOF
