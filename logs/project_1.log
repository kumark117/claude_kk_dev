        {"choices": []},
        {"choices": "x"},
        {"choices": {}},
        {"choices": [None]},
        {"choices": [{}]},
        {"choices": [{"message": None}]},
        {"choices": [{"message": "x"}]},
        {"choices": [{"message": {}}]},
        completion(None),
        completion(42),
        completion([{"type": "text"}]),
        completion(""),
    ],
)
def test_proxy_unusable_content_raises_llm_error(payload):
