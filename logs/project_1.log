import os, signal, socket, subprocess, sys, time, urllib.request, urllib.error

def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]

front, dead = free_port(), free_port()
env = {**os.environ, "BACKEND_URL": f"http://127.0.0.1:{dead}", "NEXT_TELEMETRY_DISABLED": "1"}
p = subprocess.Popen(
    ["node_modules/.bin/next", "start", "--hostname", "127.0.0.1", "--port", str(front)],
    cwd="frontend", env=env, start_new_session=True,
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    req = urllib.request.Request(f"http://127.0.0.1:{front}/api/ask", data=b'{"question":"water"}')
    for _ in range(300):
        try:
            r = opener.open(req, timeout=30)
            print(r.status, r.read()); break
        except urllib.error.HTTPError as e:
            print(e.code, e.read()); break
        except urllib.error.URLError:
            time.sleep(0.3)
finally:
    os.killpg(p.pid, signal.SIGTERM)
    p.wait(timeout=20)
EOF
