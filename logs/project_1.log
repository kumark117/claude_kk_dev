"""Load documents, split them into chunks and rank the chunks with BM25."""

import math
import re
from collections import Counter
from dataclasses import dataclass
from pathlib import Path

SUFFIXES = (".md", ".txt")
MAX_CHUNK_CHARS = 800
TOP_K = 3
K1 = 1.5
B = 0.75
STOPWORDS = frozenset(
    "a an and are as at be by can do does for from how i in is it of on or "
    "that the this to was what when where which who why with you".split()
)

_BLANK_LINES = re.compile(r"\n\s*\n")
# Runs of letters and digits: "\w" without the underscore.
_TOKEN = re.compile(r"[^\W_]+")


class DocumentError(Exception):
    """The documents folder or one of its files cannot be read."""


@dataclass(frozen=True)
class Chunk:
    file: str
    position: int
    text: str


@dataclass(frozen=True)
class ScoredChunk:
    chunk: Chunk
    score: float


def load_chunks(folder: Path) -> list[Chunk]:
    """Chunk every .md and .txt file directly inside ``folder``."""
    if not folder.is_dir():
        raise DocumentError(f"Documents folder not found: {folder}")

    try:
        paths = sorted(
            (p for p in folder.iterdir() if p.suffix in SUFFIXES and p.is_file()),
            key=lambda p: p.name,
        )
    except OSError as error:
        raise DocumentError(f"Cannot read documents folder: {error}") from error

    chunks = []
    for path in paths:
        try:
            # "utf-8-sig" also accepts a leading byte order mark and removes it.
            text = path.read_text(encoding="utf-8-sig")
        except UnicodeDecodeError as error:
            raise DocumentError(f"Document is not valid UTF-8: {path}") from error
        except OSError as error:
            raise DocumentError(f"Cannot read document: {error}") from error
        chunks.extend(
            Chunk(path.name, position, piece)
            for position, piece in enumerate(chunk_text(text))
        )
    return chunks


def chunk_text(text: str) -> list[str]:
    """Split on blank lines, keep headings with their text, limit the length."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    blocks = [block.strip() for block in _BLANK_LINES.split(text)]

    pieces = []
    headings = []
    for block in blocks:
        if not block:
            continue
        if all(line.lstrip().startswith("#") for line in block.split("\n")):
            headings.append(block)
            continue
        pieces.extend(_split_long("\n".join([*headings, block])))
        headings = []
    # Headings still waiting here have no following block, so they are dropped.
    return pieces


def _split_long(text: str) -> list[str]:
    pieces = []
    while len(text) > MAX_CHUNK_CHARS:
        # The last whitespace that leaves a piece of at most MAX_CHUNK_CHARS.
        cut = next(
            (i for i in range(MAX_CHUNK_CHARS, 0, -1) if text[i].isspace()),
            MAX_CHUNK_CHARS,
        )
        pieces.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    pieces.append(text)
    return pieces


def tokenize(text: str) -> list[str]:
    return [token for token in _TOKEN.findall(text.lower()) if token not in STOPWORDS]


class BM25Index:
    def __init__(self, chunks: list[Chunk]):
        self.chunks = list(chunks)
        self._counts = [Counter(tokenize(chunk.text)) for chunk in self.chunks]
        self._lengths = [counts.total() for counts in self._counts]
        self._average_length = sum(self._lengths) / max(len(self.chunks), 1)
        # In how many chunks each token occurs.
        self._chunk_frequency = Counter(
            token for counts in self._counts for token in counts
        )

    def search(self, question: str) -> list[ScoredChunk]:
        """Return the best matching chunks, at most TOP_K, all scoring above 0."""
        # A dict keeps the order stable, so equal chunks get identical sums.
        tokens = list(dict.fromkeys(tokenize(question)))
        results = []
        for chunk, counts, length in zip(self.chunks, self._counts, self._lengths):
            score = sum(
                self._term_score(token, counts[token], length)
                for token in tokens
                if token in counts
            )
            if score > 0:
                results.append(ScoredChunk(chunk, score))
        results.sort(key=lambda r: (-r.score, r.chunk.file, r.chunk.position))
        return results[:TOP_K]

    def _term_score(self, token: str, frequency: int, length: int) -> float:
        containing = self._chunk_frequency[token]
        idf = math.log(1 + (len(self.chunks) - containing + 0.5) / (containing + 0.5))
        norm = 1 - B + B * length / self._average_length
        return idf * frequency * (K1 + 1) / (frequency + K1 * norm)
EOF
cat > app/llm.py <<'EOF'
"""Turn a question and retrieved chunks into an answer: stub or proxy."""

from collections.abc import Mapping
from dataclasses import dataclass, field

import httpx

from app.retrieval import Chunk

TIMEOUT_SECONDS = 30.0
SYSTEM_PROMPT = (
    "Answer the question using only the supplied context. "
    "If the context is not enough to answer, say so."
)


class ConfigError(Exception):
    """The environment does not describe a usable LLM setup."""


class LLMError(Exception):
    """The LLM request failed. The message never holds the key or reply body."""


@dataclass(frozen=True)
class LLMSettings:
    url: str = ""
    model: str = ""
    api_key: str = field(default="", repr=False)

    @property
    def mode(self) -> str:
        return "proxy" if self.url else "stub"


def load_settings(env: Mapping[str, str]) -> LLMSettings:
    settings = LLMSettings(
        url=env.get("LLM_PROXY_URL", ""),
        model=env.get("LLM_PROXY_MODEL", ""),
        api_key=env.get("LLM_PROXY_API_KEY", ""),
    )
    if settings.mode == "proxy" and not settings.model:
        raise ConfigError("LLM_PROXY_MODEL is required when LLM_PROXY_URL is set")
    return settings


def generate_answer(
    question: str,
    chunks: list[Chunk],
    settings: LLMSettings,
    transport: httpx.BaseTransport | None = None,
) -> str:
    """Answer from ``chunks``, which must be non-empty and ordered best first."""
    if settings.mode == "stub":
        top = chunks[0]
        return f"[stub] Based on {top.file}: {top.text}"
    return _ask_proxy(question, chunks, settings, transport)


def _ask_proxy(
    question: str,
    chunks: list[Chunk],
    settings: LLMSettings,
    transport: httpx.BaseTransport | None,
) -> str:
    headers = {}
    if settings.api_key:
        headers["Authorization"] = f"Bearer {settings.api_key}"
    context = "\n\n".join(f"[file: {chunk.file}]\n{chunk.text}" for chunk in chunks)
    body = {
        "model": settings.model,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {
                "role": "user",
                "content": f"Context:\n\n{context}\n\nQuestion: {question}",
            },
        ],
    }

    # Every error is raised "from None": the original exception may quote the
    # key or the reply, and must not appear in a traceback.
    try:
        with httpx.Client(transport=transport, timeout=TIMEOUT_SECONDS) as client:
            response = client.post(
                f"{settings.url.removesuffix('/')}/chat/completions",
                headers=headers,
                json=body,
            )
    except (httpx.HTTPError, httpx.InvalidURL, ValueError) as error:
        raise LLMError(f"request failed ({type(error).__name__})") from None

    if not response.is_success:
        raise LLMError(f"unexpected status {response.status_code}")

    try:
        content = response.json()["choices"][0]["message"]["content"]
    except (ValueError, LookupError, TypeError):
        raise LLMError("unusable response") from None

    if not isinstance(content, str) or not content:
        raise LLMError("response has no content")
    return content
EOF
cat > app/main.py <<'EOF'
"""App factory, settings and endpoints.

Run with: uvicorn app.main:create_app --factory
"""

import os
from collections.abc import Mapping
from pathlib import Path
from typing import Annotated, Literal

import httpx
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, StringConstraints

from app.llm import LLMError, generate_answer, load_settings
from app.retrieval import BM25Index, load_chunks

# <project root>/data, found from this file and not from the working directory.
DEFAULT_DOCS_DIR = Path(__file__).resolve().parents[2] / "data"
NO_MATCH_ANSWER = "I couldn't find anything relevant in the documents."


class AskRequest(BaseModel):
    question: Annotated[
        str,
        StringConstraints(strip_whitespace=True, min_length=1, max_length=1000),
    ]


class Source(BaseModel):
    file: str
    text: str
    score: float


class AskResponse(BaseModel):
    answer: str
    sources: list[Source]
    mode: Literal["stub", "proxy"]


def create_app(
    env: Mapping[str, str] | None = None,
    transport: httpx.BaseTransport | None = None,
) -> FastAPI:
    """Build the app from ``env`` (default: the process environment).

    ``transport`` replaces the network for LLM requests in tests.
    """
    if env is None:
        env = os.environ
    llm_settings = load_settings(env)
    docs_dir = env.get("DOCS_DIR")
    index = BM25Index(load_chunks(Path(docs_dir) if docs_dir else DEFAULT_DOCS_DIR))

    app = FastAPI(title="Minimal RAG")

    @app.get("/health")
    def health():
        return {"status": "ok", "chunks": len(index.chunks)}

    @app.post("/ask")
    def ask(request: AskRequest) -> AskResponse:
        results = index.search(request.question)
        answer = NO_MATCH_ANSWER
        if results:
            try:
                answer = generate_answer(
                    request.question,
                    [result.chunk for result in results],
                    llm_settings,
                    transport,
                )
            except LLMError:
                raise HTTPException(502, "LLM request failed") from None
        sources = [
            Source(file=r.chunk.file, text=r.chunk.text, score=r.score)
            for r in results
        ]
        return AskResponse(answer=answer, sources=sources, mode=llm_settings.mode)

    return app
EOF
