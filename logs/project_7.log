"""Loading, chunking and BM25 ranking of local documents."""

import math
import re
from collections import Counter
from dataclasses import dataclass
from pathlib import Path

MAX_CHUNK_CHARS = 800
MAX_RESULTS = 3
K1 = 1.5
B = 0.75
SUFFIXES = (".md", ".txt")
STOPWORDS = frozenset(
    "a an and are as at be by can do does for from how i in is it of on or that "
    "the this to was what when where which who why with you".split()
)
# Runs of Unicode letters and digits: "\w" without the underscore.
TOKEN_PATTERN = re.compile(r"[^\W_]+")


class DocumentError(Exception):
    """The documents folder cannot be loaded."""


@dataclass(frozen=True)
class Chunk:
    file: str
    position: int
    text: str


@dataclass(frozen=True)
class Result:
    chunk: Chunk
    score: float


def load_chunks(folder: Path) -> list[Chunk]:
    """Chunk every .md and .txt file directly inside the folder, by file name."""
    if not folder.is_dir():
        raise DocumentError(f"Documents folder not found or not a directory: {folder}")
    paths = sorted(
        (p for p in folder.iterdir() if p.name.endswith(SUFFIXES) and p.is_file()),
        key=lambda p: p.name,
    )
    chunks = []
    for path in paths:
        try:
            # "utf-8-sig" is UTF-8 that also drops a leading byte order mark.
            text = path.read_text(encoding="utf-8-sig")
        except UnicodeDecodeError as error:
            raise DocumentError(f"Document is not valid UTF-8: {path} ({error})") from error
        chunks.extend(
            Chunk(file=path.name, position=position, text=piece)
            for position, piece in enumerate(chunk_text(text))
        )
    return chunks


def chunk_text(text: str) -> list[str]:
    """Split text on blank lines, attach headings, and cap the chunk length."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    chunks = []
    headings: list[str] = []
    for block in re.split(r"\n\s*\n", text):
        block = block.strip()
        if not block:
            continue
        if _is_heading_block(block):
            headings.append(block)
            continue
        chunks.extend(_split_long("\n".join([*headings, block])))
        headings = []
    # Headings still pending here have no following block and are dropped.
    return chunks


def _is_heading_block(block: str) -> bool:
    return all(line.lstrip().startswith("#") for line in block.split("\n"))


def _split_long(text: str) -> list[str]:
    pieces = []
    while len(text) > MAX_CHUNK_CHARS:
        # Whitespace at index MAX_CHUNK_CHARS still leaves a full-length piece.
        cut = next(
            (i for i in range(MAX_CHUNK_CHARS, 0, -1) if text[i].isspace()),
            MAX_CHUNK_CHARS,
        )
        pieces.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    if text:
        pieces.append(text)
    return pieces


def tokenize(text: str) -> list[str]:
    return [t for t in TOKEN_PATTERN.findall(text.lower()) if t not in STOPWORDS]


class Index:
    """An in-memory BM25 index over chunks."""

    def __init__(self, chunks: list[Chunk]):
        self.chunks = list(chunks)
        self._counts = [Counter(tokenize(c.text)) for c in self.chunks]
        self._lengths = [counts.total() for counts in self._counts]
        self._average = sum(self._lengths) / len(self._lengths) if self._lengths else 0.0
        self._containing = Counter(token for counts in self._counts for token in counts)

    def search(self, question: str) -> list[Result]:
        """Return the best matching chunks, at most MAX_RESULTS, all scoring above 0."""
        # dict.fromkeys keeps the order, so float sums are the same on every run.
        tokens = list(dict.fromkeys(tokenize(question)))
        total = len(self.chunks)
        idf = {
            t: math.log(1 + (total - self._containing[t] + 0.5) / (self._containing[t] + 0.5))
            for t in tokens
        }
        results = []
        for chunk, counts, length in zip(self.chunks, self._counts, self._lengths):
            score = 0.0
            for token in tokens:
                frequency = counts[token]
                if frequency:
                    norm = K1 * (1 - B + B * length / self._average)
                    score += idf[token] * frequency * (K1 + 1) / (frequency + norm)
            if score > 0:
                results.append(Result(chunk=chunk, score=score))
        results.sort(key=lambda r: (-r.score, r.chunk.file, r.chunk.position))
        return results[:MAX_RESULTS]
EOF
cat > backend/app/llm.py <<'EOF'
"""The language model: a built-in stub, or an OpenAI-compatible proxy."""

from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass

import httpx

from app.retrieval import Chunk

TIMEOUT_SECONDS = 30.0
SYSTEM_PROMPT = (
    "Answer the question using only the supplied context. "
    "If the context is not enough to answer, say so."
)


class ConfigError(Exception):
    """The LLM settings are incomplete."""


class LLMError(Exception):
    """The proxy request failed. Never carries the API key or the response body."""


@dataclass(frozen=True)
class LLM:
    mode: str  # "stub" or "proxy"
    answer: Callable[[str, Sequence[Chunk]], str]


def build_llm(env: Mapping[str, str], transport: httpx.BaseTransport | None = None) -> LLM:
    """Choose the mode: proxy if LLM_PROXY_URL is non-empty, otherwise stub."""
    url = env.get("LLM_PROXY_URL", "")
    if not url:
        return LLM(mode="stub", answer=_stub_answer)

    model = env.get("LLM_PROXY_MODEL", "")
    if not model:
        raise ConfigError("LLM_PROXY_MODEL is required when LLM_PROXY_URL is set")
    key = env.get("LLM_PROXY_API_KEY", "")
    endpoint = f"{url.rstrip('/')}/chat/completions"
    headers = {"Authorization": f"Bearer {key}"} if key else {}

    def answer(question: str, chunks: Sequence[Chunk]) -> str:
        body = {"model": model, "messages": _messages(question, chunks)}
        # "from None" keeps the original exception, which may quote the key or
        # the upstream body, out of any traceback.
        try:
            with httpx.Client(transport=transport, timeout=TIMEOUT_SECONDS) as client:
                response = client.post(endpoint, headers=headers, json=body)
        except (httpx.HTTPError, httpx.InvalidURL, UnicodeError):
            raise LLMError("The request to the LLM proxy failed") from None
        if not response.is_success:
            raise LLMError(f"The LLM proxy returned status {response.status_code}")
        try:
            content = response.json()["choices"][0]["message"]["content"]
        except (ValueError, KeyError, IndexError, TypeError):
            raise LLMError("The LLM proxy returned an unusable response") from None
        if not isinstance(content, str) or not content:
            raise LLMError("The LLM proxy returned no answer text")
        return content

    return LLM(mode="proxy", answer=answer)


def _stub_answer(question: str, chunks: Sequence[Chunk]) -> str:
    top = chunks[0]
    return f"[stub] Based on {top.file}: {top.text}"


def _messages(question: str, chunks: Sequence[Chunk]) -> list[dict[str, str]]:
    context = "\n\n".join(f"[File: {c.file}]\n{c.text}" for c in chunks)
    return [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": f"Context:\n\n{context}\n\nQuestion: {question}"},
    ]
EOF
cat > backend/app/main.py <<'EOF'
"""App factory, settings and endpoints."""

import os
from collections.abc import Mapping
from pathlib import Path
from typing import Annotated, Literal

import httpx
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, StringConstraints

from app.llm import LLMError, build_llm
from app.retrieval import Index, load_chunks

DEFAULT_DOCS_DIR = Path(__file__).resolve().parents[2] / "data"
NO_MATCH_ANSWER = "I couldn't find anything relevant in the documents."


class AskRequest(BaseModel):
    question: Annotated[
        str, StringConstraints(strip_whitespace=True, min_length=1, max_length=1000)
    ]


class Source(BaseModel):
    file: str
    text: str
    score: float


class AskResponse(BaseModel):
    answer: str
    sources: list[Source]
    mode: Literal["stub", "proxy"]


class Health(BaseModel):
    status: Literal["ok"]
    chunks: int


def create_app(
    env: Mapping[str, str] | None = None,
    transport: httpx.BaseTransport | None = None,
) -> FastAPI:
    """Build the app from the environment, reading and indexing the documents once."""
    env = os.environ if env is None else env
    llm = build_llm(env, transport=transport)
    docs_dir = env.get("DOCS_DIR", "")
    index = Index(load_chunks(Path(docs_dir) if docs_dir else DEFAULT_DOCS_DIR))
    app = FastAPI(title="Minimal RAG")

    @app.get("/health")
    def health() -> Health:
        return Health(status="ok", chunks=len(index.chunks))

    @app.post("/ask")
    def ask(request: AskRequest) -> AskResponse:
        results = index.search(request.question)
        if not results:
            return AskResponse(answer=NO_MATCH_ANSWER, sources=[], mode=llm.mode)
        try:
            answer = llm.answer(request.question, [r.chunk for r in results])
        except LLMError:
            raise HTTPException(status_code=502, detail="LLM request failed") from None
        sources = [Source(file=r.chunk.file, text=r.chunk.text, score=r.score) for r in results]
        return AskResponse(answer=answer, sources=sources, mode=llm.mode)

    return app
EOF
