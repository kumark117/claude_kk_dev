"""Temporary check of the README commands (dev mode) on free ports."""
import os, signal, socket, subprocess, sys, tempfile, time
import httpx

def port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0)); return s.getsockname()[1]

env = {k: v for k, v in os.environ.items() if not k.startswith(("LLM_", "DOCS_"))}
env["NEXT_TELEMETRY_DISABLED"] = "1"
b, f = port(), port()
procs, logs = [], []
def start(cmd, extra={}):
    log = tempfile.TemporaryFile(); logs.append(log)
    p = subprocess.Popen(cmd, env={**env, **extra}, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    procs.append(p); return p
def wait(url):
    for _ in range(600):
        try: return c.get(url)
        except httpx.TransportError: time.sleep(0.5)
    raise SystemExit("not ready " + url)
def stop(p):
    for s in (signal.SIGTERM, signal.SIGKILL):
        try: os.killpg(p.pid, s)
        except ProcessLookupError: break
        try: p.wait(10)
        except subprocess.TimeoutExpired: pass
c = httpx.Client(trust_env=False, timeout=120)
try:
    backend = start("backend/.venv/bin/python -m uvicorn app.main:create_app --factory --app-dir backend --host 127.0.0.1".split() + ["--port", str(b)])
    start(["npm", "--prefix", "frontend", "run", "dev", "--", "--port", str(f), "--hostname", "127.0.0.1"], {"BACKEND_URL": f"http://127.0.0.1:{b}"})
    print(wait(f"http://127.0.0.1:{b}/health").json())
    print(wait(f"http://127.0.0.1:{f}/").status_code)
    for q in ["Why is Mars called the red planet?", "volcano eruption"]:
        r = c.post(f"http://127.0.0.1:{f}/api/ask", json={"question": q}); print(r.status_code, r.json())
    stop(backend)
    r = c.post(f"http://127.0.0.1:{f}/api/ask", json={"question": "mars"}); print(r.status_code, r.json())
finally:
    for p in procs: stop(p)
    logs[1].seek(0); print(logs[1].read().decode()[-1500:])
EOF
