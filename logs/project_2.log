import hashlib, os, signal, socket, subprocess, sys, time
from pathlib import Path
import httpx

root = Path(sys.argv[1])
def snapshot():
    skip = {"node_modules", ".next", ".venv", "__pycache__", ".pytest_cache"}
    out = {}
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in skip]
        for f in files:
            if f != "timings.log":
                p = Path(d, f); out[str(p.relative_to(root))] = hashlib.sha1(p.read_bytes()).hexdigest()
    return out
def port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0)); return s.getsockname()[1]
def start(cmd, env):
    return subprocess.Popen(cmd, cwd=root, env=env, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
def stop(p):
    try: os.killpg(p.pid, signal.SIGTERM)
    except ProcessLookupError: pass
    try: p.wait(15)
    except subprocess.TimeoutExpired: os.killpg(p.pid, signal.SIGKILL); p.wait()
def wait(url):
    for _ in range(600):
        try:
            if httpx.get(url, trust_env=False, timeout=60).status_code == 200: return
        except httpx.HTTPError: pass
        time.sleep(0.3)
    raise SystemExit(f"no answer from {url}")

before = snapshot()
env = {k: os.environ[k] for k in ("HOME", "PATH")} | {"NEXT_TELEMETRY_DISABLED": "1"}
bp, up = port(), port()
back = start(["backend/.venv/bin/python","-m","uvicorn","--factory","app.main:create_app","--app-dir","backend","--host","127.0.0.1","--port",str(bp)], env)
ui = start(["npm","--prefix","frontend","run","dev","--","--hostname","127.0.0.1","--port",str(up)], env | {"BACKEND_URL": f"http://127.0.0.1:{bp}"})
try:
    wait(f"http://127.0.0.1:{bp}/health"); wait(f"http://127.0.0.1:{up}/")
    def ask(q):
        r = httpx.post(f"http://127.0.0.1:{up}/api/ask", json={"question": q}, trust_env=False, timeout=90)
        print(r.status_code, r.text[:260])
    ask("Why does Mars look red?"); ask("Who won the football match?")
    stop(back); ask("Why does Mars look red?")
finally:
    stop(ui); stop(back)
after = snapshot()
print("files changed by dev run:", sorted(k for k in before.keys() | after.keys() if before.get(k) != after.get(k)))
EOF
