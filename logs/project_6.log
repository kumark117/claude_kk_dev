"""Document loading, chunking and BM25 ranking. Everything is held in memory."""

import math
import re
from collections import Counter
from dataclasses import dataclass
from pathlib import Path

MAX_CHUNK_CHARS = 800
MAX_RESULTS = 3
K1 = 1.5
B = 0.75

STOPWORDS = frozenset(
    "a an and are as at be by can do does for from how i in is it of on or that "
    "the this to was what when where which who why with you".split()
)

_SUFFIXES = {".md", ".txt"}
_BLANK_LINES = re.compile(r"\n\s*\n")
_TOKEN = re.compile(r"[^\W_]+")


class DocumentError(Exception):
    """The documents folder or one of its files cannot be read."""


@dataclass(frozen=True)
class Chunk:
    file: str
    position: int
    text: str


@dataclass(frozen=True)
class Match:
    file: str
    position: int
    text: str
    score: float


def load_chunks(folder: Path) -> list[Chunk]:
    """Chunk every .md and .txt file directly inside the folder."""
    try:
        paths = sorted(
            (p for p in folder.iterdir() if p.suffix in _SUFFIXES and p.is_file()),
            key=lambda p: p.name,
        )
    except OSError as error:
        raise DocumentError(
            f"Cannot read documents folder {folder}: {error.strerror}"
        ) from error

    chunks: list[Chunk] = []
    for path in paths:
        try:
            # utf-8-sig also accepts a byte order mark.
            text = path.read_text(encoding="utf-8-sig")
        except UnicodeDecodeError as error:
            raise DocumentError(f"Document {path} is not valid UTF-8") from error
        except OSError as error:
            raise DocumentError(
                f"Cannot read document {path}: {error.strerror}"
            ) from error
        chunks.extend(chunk_text(path.name, text))
    return chunks


def chunk_text(file: str, text: str) -> list[Chunk]:
    """Split on blank lines, attach headings to what follows, cap the length."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    blocks: list[str] = []
    headings: list[str] = []
    for raw in _BLANK_LINES.split(text):
        block = raw.strip()
        if not block:
            continue
        if all(line.lstrip().startswith("#") for line in block.split("\n")):
            headings.append(block)
            continue
        blocks.append("\n".join([*headings, block]))
        headings = []
    # Headings still pending here have no following block and are dropped.

    pieces = [piece for block in blocks for piece in _split_long(block)]
    return [Chunk(file, position, piece) for position, piece in enumerate(pieces)]


def _split_long(text: str) -> list[str]:
    pieces = []
    while len(text) > MAX_CHUNK_CHARS:
        # Whitespace at index MAX_CHUNK_CHARS still leaves a full-size piece.
        cut = next(
            (i for i in range(MAX_CHUNK_CHARS, 0, -1) if text[i].isspace()),
            MAX_CHUNK_CHARS,
        )
        pieces.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    pieces.append(text)
    return pieces


def tokenize(text: str) -> list[str]:
    return [t for t in _TOKEN.findall(text.lower()) if t not in STOPWORDS]


class Index:
    """BM25 index over a fixed list of chunks."""

    def __init__(self, chunks: list[Chunk]):
        self.chunks = list(chunks)
        self._counts = [Counter(tokenize(chunk.text)) for chunk in self.chunks]
        self._lengths = [counts.total() for counts in self._counts]
        self._average_length = sum(self._lengths) / max(len(self._lengths), 1)
        # Number of chunks containing each token.
        self._frequencies = Counter(t for counts in self._counts for t in counts)

    def search(self, question: str) -> list[Match]:
        """Return the best matching chunks, at most MAX_RESULTS, all above 0."""
        # dict.fromkeys keeps the order, so float sums are reproducible.
        tokens = dict.fromkeys(tokenize(question))
        total = len(self.chunks)
        matches = []
        for chunk, counts, length in zip(self.chunks, self._counts, self._lengths):
            score = 0.0
            for token in tokens:
                f = counts[token]
                if not f:
                    continue
                n = self._frequencies[token]
                idf = math.log(1 + (total - n + 0.5) / (n + 0.5))
                norm = 1 - B + B * length / self._average_length
                score += idf * f * (K1 + 1) / (f + K1 * norm)
            if score > 0:
                matches.append(Match(chunk.file, chunk.position, chunk.text, score))
        matches.sort(key=lambda m: (-m.score, m.file, m.position))
        return matches[:MAX_RESULTS]
EOF
cat > llm.py <<'EOF'
"""Answer generation: a built-in stub, or an OpenAI-compatible endpoint."""

from collections.abc import Callable, Mapping
from dataclasses import dataclass
from typing import Literal

import httpx

from app.retrieval import Match

TIMEOUT_SECONDS = 30.0

SYSTEM_PROMPT = (
    "Answer the question using only the supplied context. "
    "If the context is not enough to answer, say so."
)


class ConfigError(Exception):
    """The LLM settings are incomplete."""


class LLMError(Exception):
    """The proxy request failed or returned an unusable reply."""


@dataclass(frozen=True)
class LLM:
    mode: Literal["stub", "proxy"]
    # Takes the question and the retrieved chunks (at least one).
    answer: Callable[[str, list[Match]], str]


def create_llm(
    env: Mapping[str, str], transport: httpx.BaseTransport | None = None
) -> LLM:
    """Choose proxy mode if LLM_PROXY_URL is non-empty, otherwise stub mode."""
    base = env.get("LLM_PROXY_URL", "")
    if not base:
        return LLM("stub", _stub_answer)

    model = env.get("LLM_PROXY_MODEL", "")
    if not model:
        raise ConfigError("LLM_PROXY_MODEL is required when LLM_PROXY_URL is set")
    url = f"{base.removesuffix('/')}/chat/completions"
    key = env.get("LLM_PROXY_API_KEY", "")
    headers = {"Authorization": f"Bearer {key}"} if key else {}

    def proxy_answer(question: str, chunks: list[Match]) -> str:
        body = {"model": model, "messages": _messages(question, chunks)}
        try:
            with httpx.Client(transport=transport, timeout=TIMEOUT_SECONDS) as client:
                response = client.post(url, headers=headers, json=body)
            if not response.is_success:
                raise LLMError(f"LLM endpoint returned status {response.status_code}")
            content = response.json()["choices"][0]["message"]["content"]
        except (
            httpx.HTTPError,
            httpx.InvalidURL,
            ValueError,  # invalid JSON, or a key that cannot be sent as a header
            LookupError,
            TypeError,
        ) as error:
            # "from None": the original error may quote the key or the reply.
            raise LLMError(f"LLM request failed ({type(error).__name__})") from None
        if not isinstance(content, str) or not content:
            raise LLMError("LLM reply has no text content")
        return content

    return LLM("proxy", proxy_answer)


def _stub_answer(question: str, chunks: list[Match]) -> str:
    return f"[stub] Based on {chunks[0].file}: {chunks[0].text}"


def _messages(question: str, chunks: list[Match]) -> list[dict[str, str]]:
    context = "\n\n".join(f"[{chunk.file}]\n{chunk.text}" for chunk in chunks)
    return [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": f"Context:\n{context}\n\nQuestion: {question}"},
    ]
EOF
cat > main.py <<'EOF'
"""FastAPI app factory. Run with: uvicorn app.main:create_app --factory"""

import os
from collections.abc import Mapping
from pathlib import Path
from typing import Annotated, Literal

import httpx
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, StringConstraints

from app.llm import LLMError, create_llm
from app.retrieval import Index, load_chunks

NO_MATCH_ANSWER = "I couldn't find anything relevant in the documents."
DEFAULT_DOCS_DIR = Path(__file__).resolve().parents[2] / "data"


class AskRequest(BaseModel):
    question: Annotated[
        str, StringConstraints(strip_whitespace=True, min_length=1, max_length=1000)
    ]


class Source(BaseModel):
    file: str
    text: str
    score: float


class AskResponse(BaseModel):
    answer: str
    sources: list[Source]
    mode: Literal["stub", "proxy"]


def docs_dir(env: Mapping[str, str]) -> Path:
    configured = env.get("DOCS_DIR", "")
    return Path(configured) if configured else DEFAULT_DOCS_DIR


def create_app(
    env: Mapping[str, str] | None = None,
    transport: httpx.BaseTransport | None = None,
) -> FastAPI:
    """Build the app. Documents are read and indexed here, once."""
    env = os.environ if env is None else env
    index = Index(load_chunks(docs_dir(env)))
    llm = create_llm(env, transport)
    app = FastAPI(title="Minimal RAG")

    @app.get("/health")
    def health() -> dict[str, str | int]:
        return {"status": "ok", "chunks": len(index.chunks)}

    @app.post("/ask")
    def ask(request: AskRequest) -> AskResponse:
        matches = index.search(request.question)
        if not matches:
            return AskResponse(answer=NO_MATCH_ANSWER, sources=[], mode=llm.mode)
        try:
            answer = llm.answer(request.question, matches)
        except LLMError:
            raise HTTPException(status_code=502, detail="LLM request failed") from None
        sources = [Source(file=m.file, text=m.text, score=m.score) for m in matches]
        return AskResponse(answer=answer, sources=sources, mode=llm.mode)

    return app
EOF
