import os, signal, subprocess, sys, tempfile, time
import httpx
bp, fp = sys.argv[1:]
def start(cmd, log, **env):
    return subprocess.Popen(cmd, env={**os.environ, **env}, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
def stop(p):
    try: os.killpg(p.pid, signal.SIGTERM)
    except ProcessLookupError: pass
    try: p.wait(10)
    except subprocess.TimeoutExpired: pass
    try: os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError: pass
    p.wait()
def wait(url):
    for _ in range(300):
        try: return http.get(url)
        except httpx.TransportError: time.sleep(0.2)
    raise SystemExit("not ready " + url)
http = httpx.Client(trust_env=False, timeout=90)
back_log, front_log = tempfile.TemporaryFile(), tempfile.TemporaryFile()
back = start([sys.executable, "-m", "uvicorn", "app.main:create_app", "--factory", "--app-dir", "backend", "--host", "127.0.0.1", "--port", bp], back_log)
front = None
try:
    front = start(["npm", "--prefix", "frontend", "run", "dev", "--", "--port", fp, "--hostname", "127.0.0.1"], front_log, BACKEND_URL=f"http://127.0.0.1:{bp}")
    print("health", wait(f"http://127.0.0.1:{bp}/health").json())
    page = wait(f"http://127.0.0.1:{fp}/")
    print("page", page.status_code, "Ask the docs" in page.text)
    for q in ["Why does Mars look red?", "zzz unrelated quarterly taxes", "\ud800"]:
        r = http.post(f"http://127.0.0.1:{fp}/api/ask", content=__import__("json").dumps({"question": q}))
        print(r.status_code, r.text[:160])
    stop(back)
    r = http.post(f"http://127.0.0.1:{fp}/api/ask", json={"question": "Mars"})
    print("backend stopped:", r.status_code, r.text)
finally:
    stop(back)
    if front: stop(front)
    back_log.seek(0); front_log.seek(0)
    print("--- backend errors:", back_log.read().decode().count("Traceback"))
    print(front_log.read().decode())
PY
EOF
