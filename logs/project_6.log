        reply(None),
        reply(42),
        reply(["x"]),
        reply(""),
    ],
)
def test_bad_responses_raise_llm_error(response):
    with pytest.raises(LLMError):
        failing_llm(lambda request: response).answer("q", CHUNKS)


@pytest.mark.parametrize(
