"""Document loading, chunking and BM25 ranking. Plain Python, in memory."""

import math
import re
from collections import Counter
from collections.abc import Iterable
from dataclasses import dataclass
from pathlib import Path

MAX_CHUNK_CHARS = 800
MAX_RESULTS = 3
K1 = 1.5
B = 0.75
SUFFIXES = (".md", ".txt")
STOPWORDS = frozenset(
    "a an and are as at be by can do does for from how i in is it of on or that "
    "the this to was what when where which who why with you".split()
)


class DocumentError(Exception):
    """The documents folder or one of its files cannot be read."""


@dataclass(frozen=True)
class Chunk:
    file: str
    position: int
    text: str


@dataclass(frozen=True)
class Hit:
    file: str
    text: str
    score: float


def load_chunks(folder: Path) -> list[Chunk]:
    """Read the *.md and *.txt files directly inside folder and chunk them."""
    if not folder.is_dir():
        raise DocumentError(f"Documents folder not found or not a folder: {folder}")
    try:
        paths = sorted(
            (p for p in folder.iterdir() if p.name.endswith(SUFFIXES) and p.is_file()),
            key=lambda p: p.name,
        )
    except OSError as error:
        raise DocumentError(f"Cannot list documents folder {folder}: {error}") from error

    chunks = []
    for path in paths:
        try:
            # utf-8-sig is UTF-8 that also drops a leading byte order mark.
            text = path.read_text(encoding="utf-8-sig")
        except UnicodeDecodeError as error:
            raise DocumentError(f"Document is not valid UTF-8: {path}") from error
        except OSError as error:
            raise DocumentError(f"Cannot read document {path}: {error}") from error
        chunks.extend(
            Chunk(path.name, position, piece)
            for position, piece in enumerate(chunk_text(text))
        )
    return chunks


def chunk_text(text: str) -> list[str]:
    """Split text on blank lines, attach headings, and cap the chunk length."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    chunks = []
    headings: list[str] = []
    for block in re.split(r"\n\s*\n", text):
        block = block.strip()
        if not block:
            continue
        if all(line.lstrip().startswith("#") for line in block.split("\n")):
            headings.append(block)
            continue
        chunks.extend(_split_long("\n".join([*headings, block])))
        headings = []
    # Headings still pending here have no following block and are dropped.
    return chunks


def _split_long(text: str) -> list[str]:
    pieces = []
    while len(text) > MAX_CHUNK_CHARS:
        # A break at index MAX_CHUNK_CHARS still leaves a piece that fits.
        breaks = re.finditer(r"\s", text[: MAX_CHUNK_CHARS + 1])
        cut = max((match.start() for match in breaks), default=MAX_CHUNK_CHARS)
        pieces.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    if text:
        pieces.append(text)
    return pieces


def tokenize(text: str) -> list[str]:
    """Lowercase runs of Unicode letters and digits, without stopwords."""
    return [t for t in re.findall(r"[^\W_]+", text.lower()) if t not in STOPWORDS]


class Index:
    """BM25 index over a fixed list of chunks."""

    def __init__(self, chunks: Iterable[Chunk]):
        self.chunks = list(chunks)
        self._counts = [Counter(tokenize(chunk.text)) for chunk in self.chunks]
        self._lengths = [counts.total() for counts in self._counts]
        self._average_length = sum(self._lengths) / max(len(self.chunks), 1)
        self._containing = Counter(t for counts in self._counts for t in counts)

    def search(self, question: str) -> list[Hit]:
        """Return the best chunks with a score above 0, best first."""
        tokens = list(dict.fromkeys(tokenize(question)))
        scored = []
        for chunk, counts, length in zip(self.chunks, self._counts, self._lengths):
            score = sum(
                self._term_score(token, counts[token], length)
                for token in tokens
                if token in counts
            )
            if score > 0:
                scored.append((score, chunk))
        scored.sort(key=lambda item: (-item[0], item[1].file, item[1].position))
        return [
            Hit(chunk.file, chunk.text, score)
            for score, chunk in scored[:MAX_RESULTS]
        ]

    def _term_score(self, token: str, frequency: int, length: int) -> float:
        total = len(self.chunks)
        containing = self._containing[token]
        idf = math.log(1 + (total - containing + 0.5) / (containing + 0.5))
        norm = 1 - B + B * length / self._average_length
        return idf * frequency * (K1 + 1) / (frequency + K1 * norm)
EOF

cat > backend/app/llm.py <<'EOF'
"""Answer generation: a built-in stub or an OpenAI-compatible proxy."""

from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass

import httpx

from app.retrieval import Hit

TIMEOUT_SECONDS = 30.0
SYSTEM_PROMPT = (
    "Answer the question using only the supplied context. "
    "If the context is not enough to answer, say so."
)


class LLMError(Exception):
    """The LLM request failed. Messages never hold the key or upstream body."""


class LLMConfigError(Exception):
    """The LLM environment variables are incomplete."""


@dataclass(frozen=True)
class LLM:
    mode: str  # "stub" or "proxy"
    answer: Callable[[str, Sequence[Hit]], str]


def create_llm(
    env: Mapping[str, str], transport: httpx.BaseTransport | None = None
) -> LLM:
    """Choose the mode from the environment: proxy if LLM_PROXY_URL is set."""
    base = env.get("LLM_PROXY_URL", "")
    if not base:
        return LLM("stub", _stub_answer)

    model = env.get("LLM_PROXY_MODEL", "")
    if not model:
        raise LLMConfigError("LLM_PROXY_MODEL is required when LLM_PROXY_URL is set")
    url = base.rstrip("/") + "/chat/completions"
    key = env.get("LLM_PROXY_API_KEY", "")
    headers = {"Authorization": f"Bearer {key}"} if key else {}

    def proxy_answer(question: str, chunks: Sequence[Hit]) -> str:
        body = {"model": model, "messages": _messages(question, chunks)}
        # "from None" below: the original errors can carry the upstream body.
        try:
            with httpx.Client(transport=transport, timeout=TIMEOUT_SECONDS) as client:
                response = client.post(url, headers=headers, json=body)
        except (httpx.HTTPError, httpx.InvalidURL, ValueError) as error:
            raise LLMError(f"LLM request failed: {type(error).__name__}") from None
        if not response.is_success:
            raise LLMError(f"LLM returned status {response.status_code}") from None
        try:
            content = response.json()["choices"][0]["message"]["content"]
        except (ValueError, LookupError, TypeError):
            raise LLMError("LLM returned an unreadable response") from None
        if not isinstance(content, str) or not content:
            raise LLMError("LLM returned no answer text") from None
        return content

    return LLM("proxy", proxy_answer)


def _stub_answer(question: str, chunks: Sequence[Hit]) -> str:
    top = chunks[0]
    return f"[stub] Based on {top.file}: {top.text}"


def _messages(question: str, chunks: Sequence[Hit]) -> list[dict[str, str]]:
    context = "\n\n".join(f"[{chunk.file}]\n{chunk.text}" for chunk in chunks)
    return [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": f"Context:\n\n{context}\n\nQuestion: {question}"},
    ]
EOF

cat > backend/app/main.py <<'EOF'
"""FastAPI app factory, settings and endpoints."""

import os
from collections.abc import Mapping
from dataclasses import asdict
from pathlib import Path
from typing import Annotated

import httpx
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, StringConstraints

from app.llm import LLMError, create_llm
from app.retrieval import Index, load_chunks

DEFAULT_DOCS_DIR = Path(__file__).resolve().parents[2] / "data"
NO_MATCH_ANSWER = "I couldn't find anything relevant in the documents."


class AskRequest(BaseModel):
    question: Annotated[
        str, StringConstraints(strip_whitespace=True, min_length=1, max_length=1000)
    ]


class Source(BaseModel):
    file: str
    text: str
    score: float


class AskResponse(BaseModel):
    answer: str
    sources: list[Source]
    mode: str


def create_app(
    env: Mapping[str, str] | None = None,
    transport: httpx.BaseTransport | None = None,
) -> FastAPI:
    """Build the app. Documents are read and indexed here, once.

    env defaults to the process environment; transport is for tests.
    """
    env = os.environ if env is None else env
    llm = create_llm(env, transport=transport)
    docs_dir = env.get("DOCS_DIR", "")
    index = Index(load_chunks(Path(docs_dir) if docs_dir else DEFAULT_DOCS_DIR))
    app = FastAPI(title="Minimal RAG")

    @app.get("/health")
    def health() -> dict[str, str | int]:
        return {"status": "ok", "chunks": len(index.chunks)}

    @app.post("/ask")
    def ask(request: AskRequest) -> AskResponse:
        hits = index.search(request.question)
        if not hits:
            return AskResponse(answer=NO_MATCH_ANSWER, sources=[], mode=llm.mode)
        try:
            answer = llm.answer(request.question, hits)
        except LLMError:
            raise HTTPException(status_code=502, detail="LLM request failed") from None
        return AskResponse(
            answer=answer,
            sources=[Source(**asdict(hit)) for hit in hits],
            mode=llm.mode,
        )

    return app
EOF
