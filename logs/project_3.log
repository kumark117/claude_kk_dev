import os, signal, socket, subprocess, sys, tempfile, time
import httpx
def port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0)); return s.getsockname()[1]
bp, wp = port(), port()
env = {**os.environ, "NEXT_TELEMETRY_DISABLED": "1"}
procs, logs = [], []
def start(cmd, extra={}):
    log = tempfile.TemporaryFile(); logs.append(log)
    procs.append(subprocess.Popen(cmd, env={**env, **extra}, stdout=log, stderr=log, start_new_session=True))
def stop(p):
    try: os.killpg(p.pid, signal.SIGTERM); p.wait(15)
    except ProcessLookupError: pass
    try: os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError: pass
try:
    start(["backend/.venv/bin/python","-m","uvicorn","app.main:create_app","--factory","--app-dir","backend","--port",str(bp)])
    start(["npm","--prefix","frontend","run","dev","--","--port",str(wp)], {"BACKEND_URL": f"http://127.0.0.1:{bp}"})
    c = httpx.Client(base_url=f"http://localhost:{wp}", trust_env=False, timeout=120)
    for _ in range(240):
        try:
            if c.get("/").status_code == 200 and httpx.get(f"http://127.0.0.1:{bp}/health", trust_env=False).status_code == 200: break
        except httpx.HTTPError: pass
        time.sleep(0.5)
    for q in ["How often should I check tyre pressure?", "Explain quantum chromodynamics"]:
        r = c.post("/api/ask", json={"question": q}); print(r.status_code, r.text[:260])
    stop(procs[0])
    r = c.post("/api/ask", json={"question": "tyre"}); print("backend stopped:", r.status_code, r.text)
finally:
    for p in procs: stop(p)
    for l in logs:
        l.seek(0); print("--- log ---"); print(l.read().decode()[-1500:])
EOF
