cat > backend/tests/test_retrieval.py <<'EOF'
import math

import pytest

from app import retrieval
from app.retrieval import (
    Chunk,
    DocumentError,
    Index,
    chunk_text,
    load_chunks,
    tokenize,
)


def make_index(*texts):
    return Index([Chunk(file=f"{i}.md", position=0, text=t) for i, t in enumerate(texts)])


def test_loads_only_md_and_txt_sorted_by_name_without_recursion(tmp_path):
    (tmp_path / "b.txt").write_text("bravo", encoding="utf-8")
    (tmp_path / "a.md").write_text("alpha one\n\nalpha two", encoding="utf-8")
    (tmp_path / "c.rst").write_text("ignored", encoding="utf-8")
    (tmp_path / "sub").mkdir()
    (tmp_path / "sub" / "d.md").write_text("nested", encoding="utf-8")
    (tmp_path / "folder.md").mkdir()

    chunks = load_chunks(tmp_path)

    assert chunks == [
        Chunk("a.md", 0, "alpha one"),
        Chunk("a.md", 1, "alpha two"),
        Chunk("b.txt", 0, "bravo"),
    ]


def test_reads_utf8_text(tmp_path):
    (tmp_path / "a.md").write_bytes("café ☕".encode("utf-8"))

    assert load_chunks(tmp_path)[0].text == "café ☕"


def test_splits_on_blank_lines_and_normalizes_line_endings():
    text = "  first line\r\nsecond line  \r\n\r\n   \r\nthird\r\rfourth\n"

    assert chunk_text(text) == ["first line\nsecond line", "third", "fourth"]


def test_heading_blocks_join_the_next_block():
    text = "# Title\n\n## Section\n### Sub\n\nBody text.\n\nMore."

    assert chunk_text(text) == ["# Title\n## Section\n### Sub\nBody text.", "More."]


def test_trailing_heading_is_dropped():
    assert chunk_text("Body.\n\n# Dangling") == ["Body."]
    assert chunk_text("# Only heading") == []


def test_block_with_heading_and_text_is_an_ordinary_block():
    assert chunk_text("# Title\ntext\n\nnext") == ["# Title\ntext", "next"]


def test_long_chunk_splits_at_whitespace():
    text = " ".join(["abcdefghi"] * 200)  # 1999 characters

    pieces = chunk_text(text)

    assert [len(p) for p in pieces] == [799, 799, 399]
    assert " ".join(pieces) == text


def test_chunk_of_exactly_800_is_not_split():
    text = "a" * 399 + " " + "b" * 400

    assert chunk_text(text) == [text]


def test_word_ending_exactly_at_the_limit_stays_in_the_first_piece():
    first = "a" * 399 + " " + "b" * 400

    assert chunk_text(first + " tail") == [first, "tail"]


def test_single_long_word_is_cut_at_800():
    assert [len(p) for p in chunk_text("x" * 1700)] == [800, 800, 100]


def test_split_pieces_get_consecutive_positions(tmp_path):
    (tmp_path / "a.md").write_text("x" * 900 + "\n\nend", encoding="utf-8")

    assert [c.position for c in load_chunks(tmp_path)] == [0, 1, 2]


def test_tokenize_lowercases_and_splits_on_punctuation_and_underscore():
    assert tokenize("Hello, WORLD! snake_case v2.5 Über-café") == [
        "hello", "world", "snake", "case", "v2", "5", "über", "café",
    ]


def test_tokenize_removes_exactly_the_listed_stopwords():
    stopwords = (
        "a an and are as at be by can do does for from how i in is it of on or "
        "that the this to was what when where which who why with you"
    )

    assert tokenize(stopwords.upper()) == []
    assert tokenize("The cat is not here") == ["cat", "not", "here"]


def test_relevant_chunk_ranks_first():
    index = make_index(
        "Bananas are yellow fruit.",
        "The solar panel converts sunlight into electricity.",
        "Sailing boats use wind.",
    )

    results = index.search("How does a solar panel make electricity?")

    assert results[0].file == "1.md"
    assert results[0].text == "The solar panel converts sunlight into electricity."
    assert results[0].score > 0


def test_score_follows_the_bm25_formula():
    index = make_index("apple apple banana", "cherry")
    idf = math.log(1 + (2 - 1 + 0.5) / (1 + 0.5))
    expected = idf * 2 * 2.5 / (2 + 1.5 * (1 - 0.75 + 0.75 * 3 / 2))

    results = index.search("apple apple")  # repeated question tokens count once

    assert [r.file for r in results] == ["0.md"]
    assert results[0].score == pytest.approx(expected)


def test_returns_at_most_three_results_ordered_by_score():
    index = make_index(
        "kiwi pear plum fig", "kiwi kiwi kiwi", "kiwi pear", "kiwi", "melon"
    )

    results = index.search("kiwi")

    assert len(results) == 3
    scores = [r.score for r in results]
    assert scores == sorted(scores, reverse=True)
    assert results[0].file == "1.md"


def test_ties_are_ordered_by_file_then_position():
    chunks = [
        Chunk("b.md", 0, "kiwi"),
        Chunk("a.md", 1, "kiwi"),
        Chunk("c.md", 0, "kiwi"),
        Chunk("a.md", 0, "kiwi"),
    ]

    results = Index(chunks).search("kiwi")

    assert [(r.file, r.position) for r in results] == [
        ("a.md", 0), ("a.md", 1), ("b.md", 0),
    ]


@pytest.mark.parametrize("question", ["zebra", "what is the", "?!_", ""])
def test_no_match_or_no_usable_tokens_returns_empty(question):
    assert make_index("the apple is red").search(question) == []


def test_empty_folder_is_allowed(tmp_path):
    index = Index(load_chunks(tmp_path))

    assert index.chunks == []
    assert index.search("anything") == []


def test_chunks_made_only_of_stopwords_do_not_break_search():
    assert make_index("the and of").search("apple") == []


def test_missing_folder_is_a_startup_error(tmp_path):
    with pytest.raises(DocumentError, match="nowhere"):
        load_chunks(tmp_path / "nowhere")


def test_invalid_utf8_is_a_startup_error(tmp_path):
    (tmp_path / "bad.txt").write_bytes(b"\xff\xfe\xfa")

    with pytest.raises(DocumentError, match="bad.txt"):
        load_chunks(tmp_path)


def test_default_docs_dir_is_data_at_project_root(monkeypatch, tmp_path):
    monkeypatch.chdir(tmp_path)

    root = retrieval.Path(__file__).resolve().parents[2]
    assert retrieval.DEFAULT_DOCS_DIR == root / "data"
EOF
cat > backend/tests/test_llm.py <<'EOF'
import json

import httpx
import pytest

from app.llm import ConfigError, LLMError, create_llm
from app.retrieval import ScoredChunk

CHUNKS = [
    ScoredChunk(file="first.md", position=0, text="Alpha text.", score=2.0),
    ScoredChunk(file="second.txt", position=3, text="Beta text.", score=1.0),
]
PROXY_ENV = {
    "LLM_PROXY_URL": "http://127.0.0.1:9/v1/",
    "LLM_PROXY_MODEL": "test-model",
    "LLM_PROXY_API_KEY": "secret-key",
}


def reply(content):
    return httpx.Response(200, json={"choices": [{"message": {"content": content}}]})


def proxy_with(handler, env=PROXY_ENV):
    return create_llm(env, transport=httpx.MockTransport(handler))


def test_stub_returns_exact_text_from_top_chunk():
    llm = create_llm({})

    assert llm.mode == "stub"
    assert llm.answer("q?", CHUNKS) == "[stub] Based on first.md: Alpha text."


@pytest.mark.parametrize(
    "env", [{}, {"LLM_PROXY_URL": ""}, {"LLM_PROXY_MODEL": "m", "LLM_PROXY_API_KEY": "k"}]
)
def test_stub_mode_without_a_proxy_url(env):
    assert create_llm(env).mode == "stub"


def test_proxy_mode_with_a_url():
    assert create_llm(PROXY_ENV).mode == "proxy"


@pytest.mark.parametrize("model", [None, ""])
def test_missing_model_fails_startup(model):
    env = {"LLM_PROXY_URL": "http://127.0.0.1:9/v1"}
    if model is not None:
        env["LLM_PROXY_MODEL"] = model

    with pytest.raises(ConfigError, match="LLM_PROXY_MODEL"):
        create_llm(env)


def test_proxy_sends_the_expected_request_and_returns_content():
    seen = []

    def handler(request):
        seen.append(request)
        return reply("Proxy answer.")

    answer = proxy_with(handler).answer("What is alpha?", CHUNKS)

    assert answer == "Proxy answer."
    (request,) = seen
    assert request.method == "POST"
    assert str(request.url) == "http://127.0.0.1:9/v1/chat/completions"
    assert request.headers["authorization"] == "Bearer secret-key"
    assert request.headers["content-type"] == "application/json"
    body = json.loads(request.content)
    assert set(body) == {"model", "messages"}
    assert body["model"] == "test-model"
    system, user = body["messages"]
    assert system["role"] == "system"
    assert "only" in system["content"].lower()
    assert "context" in system["content"].lower()
    assert "not enough" in system["content"].lower()
    assert user["role"] == "user"
    content = user["content"]
    order = [
        content.index(part)
        for part in ("first.md", "Alpha text.", "second.txt", "Beta text.", "What is alpha?")
    ]
    assert order == sorted(order)


def test_proxy_uses_a_30_second_timeout():
    seen = []

    def handler(request):
        seen.append(request.extensions["timeout"])
        return reply("ok")

    proxy_with(handler).answer("q", CHUNKS)

    assert seen == [{"connect": 30.0, "read": 30.0, "write": 30.0, "pool": 30.0}]


@pytest.mark.parametrize("key", [None, ""])
def test_no_auth_header_without_a_key(key):
    env = {k: v for k, v in PROXY_ENV.items() if k != "LLM_PROXY_API_KEY"}
    if key is not None:
        env["LLM_PROXY_API_KEY"] = key
    seen = []

    def handler(request):
        seen.append(request)
        return reply("ok")

    proxy_with(handler, env).answer("q", CHUNKS)

    assert "authorization" not in seen[0].headers


def raise_connect_error(request):
    raise httpx.ConnectError("refused", request=request)


def raise_timeout(request):
    raise httpx.ReadTimeout("slow", request=request)


def respond(*args, **kwargs):
    return lambda request: httpx.Response(*args, **kwargs)


@pytest.mark.parametrize(
    "handler",
    [
        raise_connect_error,
        raise_timeout,
        respond(500, json={"choices": [{"message": {"content": "no"}}]}),
        respond(401, text="upstream-secret-body"),
        respond(302, headers={"location": "http://127.0.0.1:9/other"}),
        respond(200, text="not json"),
        respond(200, content=b"\xff\xfe\xfa"),
        respond(200, json=[]),
        respond(200, json={}),
        respond(200, json={"choices": []}),
        respond(200, json={"choices": "text"}),
        respond(200, json={"choices": [{}]}),
        respond(200, json={"choices": [{"message": None}]}),
        respond(200, json={"choices": [{"message": {}}]}),
        respond(200, json={"choices": [{"message": {"content": None}}]}),
        respond(200, json={"choices": [{"message": {"content": 5}}]}),
        respond(200, json={"choices": [{"message": {"content": ""}}]}),
    ],
)
def test_every_failure_raises_the_llm_error_without_secrets(handler):
    with pytest.raises(LLMError) as caught:
        proxy_with(handler).answer("q", CHUNKS)

    assert "secret-key" not in str(caught.value)
    assert "upstream-secret-body" not in str(caught.value)
    assert caught.value.__cause__ is None
    assert caught.value.__suppress_context__


@pytest.mark.parametrize(
    "overrides",
    [
        {"LLM_PROXY_URL": "http://[broken"},
        {"LLM_PROXY_API_KEY": "kéy-☃"},
    ],
)
def test_unusable_settings_raise_the_llm_error(overrides):
    with pytest.raises(LLMError):
        proxy_with(lambda request: reply("ok"), {**PROXY_ENV, **overrides}).answer("q", CHUNKS)
EOF
cat > backend/tests/test_api.py <<'EOF'
import httpx
import pytest
from fastapi.testclient import TestClient

from app.main import create_app

NO_MATCH = "I couldn't find anything relevant in the documents."


@pytest.fixture
def docs(tmp_path):
    (tmp_path / "fruit.md").write_text(
        "# Fruit\n\nKiwi is green inside.\n\nBananas are yellow.", encoding="utf-8"
    )
    (tmp_path / "boats.txt").write_text("Sailing boats use wind.", encoding="utf-8")
    return tmp_path


def proxy_env(docs):
    return {
        "DOCS_DIR": str(docs),
        "LLM_PROXY_URL": "http://127.0.0.1:9/v1",
        "LLM_PROXY_MODEL": "m",
        "LLM_PROXY_API_KEY": "secret-key",
    }


def test_health_reports_chunk_count(docs):
    client = TestClient(create_app({"DOCS_DIR": str(docs)}))

    response = client.get("/health")

    assert response.status_code == 200
    assert response.json() == {"status": "ok", "chunks": 3}


def test_factory_reads_the_process_environment(docs, monkeypatch):
    monkeypatch.delenv("LLM_PROXY_URL", raising=False)
    monkeypatch.setenv("DOCS_DIR", str(docs))

    client = TestClient(create_app())

    assert client.get("/health").json()["chunks"] == 3


def test_documents_are_read_once_at_startup(docs):
    client = TestClient(create_app({"DOCS_DIR": str(docs)}))
    (docs / "later.md").write_text("Added later.", encoding="utf-8")

    assert client.get("/health").json()["chunks"] == 3


def test_successful_ask_has_the_expected_shape(docs):
    client = TestClient(create_app({"DOCS_DIR": str(docs)}))

    response = client.post("/ask", json={"question": "  What colour is kiwi?  "})

    assert response.status_code == 200
    body = response.json()
    assert set(body) == {"answer", "sources", "mode"}
    assert body["mode"] == "stub"
    assert body["answer"] == "[stub] Based on fruit.md: # Fruit\nKiwi is green inside."
    (source,) = body["sources"]
    assert set(source) == {"file", "text", "score"}
    assert source["file"] == "fruit.md"
    assert source["text"] == "# Fruit\nKiwi is green inside."
    assert source["score"] > 0


@pytest.mark.parametrize(
    "payload",
    [
        {"question": ""},
        {"question": "   \n\t "},
        {"question": "x" * 1001},
        {"question": 5},
        {},
    ],
)
def test_invalid_questions_get_422(docs, payload):
    client = TestClient(create_app({"DOCS_DIR": str(docs)}))

    assert client.post("/ask", json=payload).status_code == 422


@pytest.mark.parametrize("question", ["x", "x" * 1000, "  " + "x" * 1000 + "  "])
def test_length_limits_apply_after_trimming(docs, question):
    client = TestClient(create_app({"DOCS_DIR": str(docs)}))

    assert client.post("/ask", json={"question": question}).status_code == 200


def test_proxy_answer_and_mode(docs):
    def handler(request):
        return httpx.Response(200, json={"choices": [{"message": {"content": "Green."}}]})

    client = TestClient(create_app(proxy_env(docs), transport=httpx.MockTransport(handler)))

    body = client.post("/ask", json={"question": "kiwi"}).json()

    assert body["answer"] == "Green."
    assert body["mode"] == "proxy"
    assert body["sources"][0]["file"] == "fruit.md"


def test_no_match_does_not_call_the_llm(docs):
    calls = []

    def handler(request):
        calls.append(request)
        return httpx.Response(500)

    client = TestClient(create_app(proxy_env(docs), transport=httpx.MockTransport(handler)))

    response = client.post("/ask", json={"question": "zebra"})

    assert response.status_code == 200
    assert response.json() == {"answer": NO_MATCH, "sources": [], "mode": "proxy"}
    assert calls == []


def test_empty_folder_answers_with_no_match(tmp_path):
    client = TestClient(create_app({"DOCS_DIR": str(tmp_path)}))

    assert client.get("/health").json() == {"status": "ok", "chunks": 0}
    assert client.post("/ask", json={"question": "kiwi"}).json() == {
        "answer": NO_MATCH, "sources": [], "mode": "stub",
    }


def test_llm_error_returns_502_without_leaking(docs, caplog):
    caplog.set_level("DEBUG")

    def handler(request):
        return httpx.Response(500, text="upstream-secret-body")

    client = TestClient(create_app(proxy_env(docs), transport=httpx.MockTransport(handler)))

    response = client.post("/ask", json={"question": "kiwi"})

    assert response.status_code == 502
    assert response.json() == {"detail": "LLM request failed"}
    assert "secret-key" not in caplog.text
    assert "upstream-secret-body" not in caplog.text
EOF
